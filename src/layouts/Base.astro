---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
import Gmail from '../components/Gmail.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string }
const { title, description = site.description, active = 'home' } = Astro.props;
const fullTitle = title ? `${title} · Zaixi` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  {id:'home', href:'/', label:'首页', icon:'home'},
  {id:'articles', href:'/articles/', label:'文章', icon:'article'},
  {id:'projects', href:'/projects/', label:'项目', icon:'grid'},
  {id:'about', href:'/about/', label:'关于', icon:'person'},
] as const;
const current = nav.find(item => item.id === active)?.label || '首页';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
  <meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={active === 'articles' ? 'article' : 'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/assets/zaixi.jpg', Astro.site)}/>
  <meta name="theme-color" content="#f8fafc"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="alternate" type="application/rss+xml" title="Zaixi 的文章" href="/rss.xml"/>
  <script is:inline>
    (() => { let theme; try { theme = localStorage.getItem('loop-theme'); } catch {} document.documentElement.dataset.theme = ['light','dark'].includes(theme) ? theme : matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light'; })();
  </script>
  <ClientRouter />
</head>
<body>
  <a class="skip-link" href="#main">跳至正文</a>
  <div class="workspace">
    <aside class="sidebar">
      <a class="identity" href="/" aria-label="Home · Zaixi"><span class="identity-mark" aria-hidden="true">z<span>_</span></span><span><strong>Zaixi</strong><small>个人博客与工程实践</small></span></a>
      <div class="sidebar-label">浏览</div>
      <nav aria-label="主导航">{nav.map((item,i) => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}><Icon name={item.icon}/><span>{item.label}</span><small>0{i+1}</small></a>)}</nav>
      <div class="sidebar-bottom"><div class="sidebar-note"><span class="status-dot"/>寻找实习机会<strong>Agent Harness</strong><span>可长期实习 · 随时到岗</span></div><button class="sidebar-contact" data-contact>与我联系 <Icon name="arrow"/></button><a class="sidebar-github" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github"/>lizaixi01<Icon name="external"/></a></div>
    </aside>
    <div class="workspace-body">
      <header class="topbar"><a class="mobile-brand" href="/">z<span>_</span></a><div class="breadcrumb"><a href="/">Zaixi</a><span>/</span><span>{current}</span></div><div class="utility"><button class="search-trigger" data-search aria-label="搜索文章与项目"><Icon name="search"/><span>搜索</span><kbd>⌘ K</kbd></button><button class="icon-button" data-terminal aria-label="打开快捷终端" title="快捷终端（反引号）"><Icon name="terminal"/></button><button class="icon-button" data-theme aria-label="切换主题" title="切换主题"><Icon name="moon" class="moon"/><Icon name="sun" class="sun"/></button></div></header>
      <main id="main" class="main-content" tabindex="-1" transition:animate="fade"><slot /></main>
      <footer class="site-footer"><div><strong>Home · Zaixi</strong><span>© 2026 李在希</span></div><div><a href="/links/">友链</a><a href="/rss.xml">RSS</a><button data-contact>联系我 <span aria-hidden="true">↗</span></button></div></footer>
    </div>
  </div>
  <nav class="mobile-nav" aria-label="手机导航">{nav.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}><Icon name={item.icon}/><span>{item.label}</span></a>)}</nav>
  <dialog class="contact-dialog dialog-panel" aria-labelledby="contact-title"><div class="dialog-head"><span class="eyebrow">保持联系</span><button class="icon-button" data-close aria-label="关闭联系窗口"><Icon name="close"/></button></div><div class="contact-grid"><div><h2 id="contact-title">认识一下？</h2><p>聊聊 Agent、正在做的项目，<br/>或下一段实习机会。</p><div class="contact-email"><Gmail/><button data-copy={site.email}>复制邮箱 <Icon name="check"/></button></div><a class="button secondary" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github"/>在 GitHub 找到我 <Icon name="external"/></a></div><figure><img src="/assets/wechat.jpg" width="818" height="1215" alt="Zaixi 的微信好友二维码" loading="lazy"/><figcaption>微信扫一扫，添加好友</figcaption></figure></div></dialog>
  <dialog class="search-dialog dialog-panel" aria-labelledby="search-title"><div class="search-top"><Icon name="search"/><label class="sr-only" id="search-title" for="site-search">搜索文章与项目</label><input type="search" id="site-search" placeholder="搜索文章、项目、关键词…" autocomplete="off"/><button class="icon-button" data-close aria-label="关闭搜索"><Icon name="close"/></button></div><div id="search-results" aria-live="polite"><p class="empty-state">输入关键词，找到感兴趣的内容。</p></div><div class="dialog-foot"><span>本站内容 · 本地检索</span><kbd>Esc 关闭</kbd></div></dialog>
  <dialog class="terminal-dialog dialog-panel" aria-labelledby="terminal-title"><div class="terminal-head"><div class="terminal-dots" aria-hidden="true"><i/><i/><i/></div><h2 id="terminal-title">zaixi@home: ~</h2><button class="icon-button" data-close aria-label="关闭快捷终端"><Icon name="close"/></button></div><div class="terminal-output" role="log" aria-live="polite"><p>欢迎来到 Zaixi 的主页。<br/>输入 <b>help</b> 查看快捷命令。</p></div><form class="terminal-form"><label for="terminal-input">~ $</label><input id="terminal-input" autocomplete="off" spellcheck="false" placeholder="help" aria-label="快捷终端命令"/><button type="submit" aria-label="执行命令"><Icon name="arrow"/></button></form><div class="terminal-hints"><button data-command="ls">ls</button><button data-command="open projects">open projects</button><button data-command="contact">contact</button><span>仅用于本站导航</span></div></dialog>
  <div class="reading-progress" aria-hidden="true"></div><button class="back-top icon-button" aria-label="回到顶部" title="回到顶部">↑</button><div class="toast" role="status" aria-live="polite"></div>
  <script>import '../scripts/site';</script>
</body>
</html>
