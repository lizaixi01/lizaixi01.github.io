---
interface Props { number: string; label: string; title: string; description?: string }
const { number, label, title, description } = Astro.props;
---
<header class="page-heading" data-reveal><div class="eyebrow"><span>{number}</span><span class="tiny-rule"/>{label}</div><h1>{title}</h1>{description && <p>{description}</p>}<slot/></header>
