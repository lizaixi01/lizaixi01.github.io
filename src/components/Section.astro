---
// Layout adapted from joyehuang/blog's home/Section.astro (Apache-2.0).
interface Props { title: string; id?: string }
const { title, id } = Astro.props;
---
<section class="home-section" id={id}>
  <div class="section-label"><h2>{title}</h2></div>
  <div class="section-content"><slot /></div>
</section>
