---
import { getCollection } from 'astro:content'

import { PostPreview } from 'astro-pure/components/pages'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order)
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
---

<PageLayout
  meta={{ title: 'Blog', description: 'Zaixi 关于 Agent 环境、协作、上下文与形式化数学的文章。' }}
>
  <Button title='Back' href='/' variant='back' />
  <main id='main' class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>Blog</h1>
    </div>
    <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
      <section aria-label='Blog posts list' class='animate' id='content'>
        <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
          <span class='text-muted-foreground'>Showing {posts.length} posts</span><a
            href='/archives/'>View all posts by years →</a
          >
        </div>
        <ul class='flex flex-col gap-y-4 text-start'>
          {posts.map((post) => <PostPreview {post} detailed />)}
        </ul>
      </section>
      <aside class='animate' id='sidebar'>
        <h2 class='mb-4 flex items-center text-lg font-semibold'>
          <Icon name='tag-2' class='me-2' />Tags
        </h2>
        <ul class='flex flex-wrap gap-2'>
          {
            tags.map((tag) => (
              <li>
                <Button title={tag} href={`/tags/${tag}/`} variant='pill' />
              </li>
            ))
          }
        </ul>
        <span class='mt-4 block sm:text-end'><a href='/tags/'>View all →</a></span>
      </aside>
    </div>
  </main>
</PageLayout>
