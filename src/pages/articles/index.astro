---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleRow from '../../components/ArticleRow.astro';
const articles = (await getCollection('articles')).sort((a,b) => a.data.order-b.data.order);
const categories = ['全部',...new Set(articles.map(p => p.data.category))];
---
<Base title="文章" active="articles" description="从个人项目与学习出发，记录关于 Agent 环境、独立验证、上下文和形式化数学的思考。">
  <PageHeader number="02" label="文章" title="思考与记录。" description="从亲手做过的项目出发，记录问题、判断，以及还需要验证的假设。"/>
  <div class="collection-toolbar" data-reveal><div class="filter-tabs" aria-label="文章分类">{categories.map((c,i) => <button data-category={c} aria-pressed={i===0}>{c}</button>)}</div><label class="sr-only" for="article-search">搜索文章标题与简介</label><input class="list-search" id="article-search" data-article-search type="search" placeholder="搜索文章…"/></div>
  <p class="result-count" data-result-count aria-live="polite">共 {articles.length} 篇文章</p>
  <div>{articles.map((article,index) => <div data-article data-category={article.data.category}><ArticleRow article={article} description index={index}/></div>)}</div>
</Base>
