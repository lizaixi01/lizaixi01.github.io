---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
export async function getStaticPaths() { return (await getCollection('articles')).map(article => ({ params: {id:article.id}, props:{article} })); }
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const articles = (await getCollection('articles')).sort((a,b) => a.data.order-b.data.order);
const next = articles[(articles.findIndex(p => p.id === article.id)+1)%articles.length];
const readingTime = Math.ceil((article.body?.length || 0)/300);
---
<Base title={article.data.title} description={article.data.description} active="articles">
  <a class="back-link" href="/articles/">← 全部文章</a>
  <header class="article-header" data-reveal><span class="eyebrow">工程思考 / {article.data.category}</span><h1>{article.data.title}</h1><p>{article.data.description}</p><div class="article-byline"><img src="/assets/avatar.webp" width="28" height="28" alt=""/><strong>Zaixi Li</strong><span class="meta-divider"/><time datetime={article.data.updated}>{article.data.updated.replaceAll('-','/')} 修订</time><span>约 {readingTime} 分钟</span></div></header>
  <details class="mobile-toc"><summary>本文目录 · {headings.length} 节</summary>{headings.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</details>
  <div class="article-layout"><article><div class="prose"><Content/></div><div class="reading-end"><a href="/articles/">← 返回文章目录</a><button data-contact>交流这篇文章 ↗</button></div><a class="article-next" href={`/articles/${next.id}/`}><div><small>下一篇思考</small><strong>{next.data.title}</strong></div><Icon name="arrow"/></a></article><nav class="toc" aria-label="本文目录"><p>在这篇文章里</p>{headings.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></div>
</Base>
