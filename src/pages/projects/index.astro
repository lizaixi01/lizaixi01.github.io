---
import { projects, site } from '@/data/site'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'open-source', text: 'Open Source' },
  { depth: 2, slug: 'experiments', text: 'Experiments' }
]
const list = (group: string) =>
  projects
    .filter((project) => project.group === group)
    .map((project) => ({
      id: project.id,
      name: project.name,
      description: project.description,
      links: [
        { type: 'doc', href: `/projects/${project.id}/` },
        { type: 'github', href: project.url }
      ]
    }))
---

<PageLayout title='Projects' {headings}>
  <p>我的公开项目，围绕 Agent 的执行、记忆、协作和验证展开。</p>
  <p><a href={site.github} target='_blank' rel='noopener noreferrer'>GitHub · lizaixi01 ↗</a></p>
  <h2 id='open-source'>Open Source</h2>
  <ProjectSection project={list('工程项目')} />
  <h2 id='experiments'>Experiments</h2>
  <ProjectSection project={list('小型实验')} />
</PageLayout>
