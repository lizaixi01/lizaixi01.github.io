---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { projects, site } from '@/data/site'

import { PostPreview } from 'astro-pure/components/pages'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import LinkCard from '@/components/home/LinkCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import Terminal from '@/components/terminal/Terminal.astro'
import avatar from '@/assets/avatar.webp'

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order)
---

<PageLayout meta={{ title: 'Home', description: site.introduction }} highlightColor='#659EB9'>
  <main id='main' class='flex w-full flex-col items-center'>
    <section
      class='animate mb-10 flex flex-col items-center gap-y-7 relative z-50'
      id='content-header'
    >
      <div class='relative'>
        <Image
          src={avatar}
          alt='Zaixi 在雪山前的旅行照片'
          class='h-28 w-28 object-cover rounded-full border p-1'
          loading='eager'
          fetchpriority='high'
        />
      </div>
      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{site.nickname}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='成都，中国'><Icon name='location' class='size-5' slot='icon' /></Label>
          <Label title='GitHub' as='a' href={site.github} target='_blank' rel='noopener noreferrer'
            ><Icon name='github' class='size-5' slot='icon' /></Label
          >
        </div>
      </div>
      <a
        href='/contact/'
        class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
      >
        <span class='relative flex items-center justify-center'
          ><span class='size-2 rounded-full bg-primary'></span></span
        >
        <p class='font-medium text-muted-foreground'>Connect Me!</p>
      </a>
    </section>
    <div
      id='content'
      class='animate relative z-0 flex w-full min-w-0 max-w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'
    >
      <div class='-mt-2'><Terminal /></div>
      <Section title='About'>
        <p class='text-muted-foreground'>{site.name} · {site.description}</p>
        <p class='text-muted-foreground'>{site.introduction}</p>
        <p class='text-muted-foreground' lang='en'>{site.englishIntroduction}</p>
        <Button title='More about me' class='w-fit self-end' href='/about/' variant='ahead' />
      </Section>
      <Section title='Blog'>
        <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
          {posts.map((post) => <PostPreview {post} />)}
        </ul>
        <Button title='More blogs' class='w-fit self-end' href='/blog/' variant='ahead' />
      </Section>
      <Section title='Open Source'>
        {
          projects
            .slice(0, 3)
            .map((project) => (
              <LinkCard
                heading={project.name}
                subheading={project.description}
                date={project.tech}
                href={`/projects/${project.id}/`}
                target='_self'
              />
            ))
        }
        <Button title='More projects' class='w-fit self-end' href='/projects/' variant='ahead' />
      </Section>
      <Section title='Education'>
        <Card
          as='div'
          heading={site.university}
          subheading={`本科 · ${site.major}`}
          date={`预计毕业：${site.graduation}`}
        />
      </Section>
      <Section title='Skills'>
        <SkillLayout title='Languages' skills={['TypeScript', 'JavaScript', 'Python', 'Verilog']} />
        <SkillLayout
          title='Engineering'
          skills={['Node.js', 'Electron', 'FastAPI', 'VS Code', 'Git']}
        />
        <SkillLayout
          title='AI & Agent'
          skills={['Agent Harness', 'Multi-Agent', 'Context', 'Memory', 'Verification']}
        />
      </Section>
      <Section title='Contact'>
        <p class='text-muted-foreground'>
          寻找 Agent Harness 工程师实习。可长期实习、随时到岗，接受异地线下。
        </p>
        <p class='text-muted-foreground'>{site.cities.join(' / ')}</p>
        <Button title='Let’s connect' class='w-fit self-end' href='/contact/' variant='ahead' />
      </Section>
      <Section title='站点统计'>
        <div class='grid grid-cols-2 gap-3'>
          {
            [
              { label: '文章', value: posts.length },
              { label: '项目', value: projects.length }
            ].map((item) => (
              <div class='rounded-xl border bg-muted/30 px-4 py-3 text-center'>
                <>
                  <div class='text-2xl font-medium tabular-nums'>{item.value}</div>
                  <div class='mt-1 text-xs text-muted-foreground'>{item.label}</div>
                </>
              </div>
            ))
          }
        </div>
      </Section>
    </div>
  </main>
</PageLayout>
