---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import Icon from '../components/Icon.astro';
import { site, projects } from '../data/site';
const articles = (await getCollection('articles')).sort((a,b) => a.data.order-b.data.order);
---
<Base description="Zaixi Li，电子科技大学在读，寻找 Agent Harness 工程师实习。公开项目、工程思考与联系方式。">
  <section class="hero" aria-label="个人介绍"><div class="hero-top" data-reveal><span class="eyebrow"><span class="status-dot"/>开放实习机会</span><span class="hero-coordinate"><Icon name="pin"/>成都，中国</span></div><div class="hero-identity" data-reveal><div><div class="hero-name-line"><h1>Zaixi<span>.</span></h1><span>李在希 / Zaixi Li</span></div><p class="hero-tagline">All in on <span>AI Agents.</span></p></div><div class="avatar-frame"><img src="/assets/avatar.webp" width="176" height="176" alt="Zaixi 在雪山前的旅行照片" fetchpriority="high"/><span class="avatar-label">Zaixi / 成都</span></div></div><p class="hero-description" data-reveal>{site.introduction}</p><div class="hero-actions" data-reveal><button class="button primary" data-contact>与我联系 <Icon name="arrow"/></button><a class="button secondary" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github"/>GitHub <Icon name="external"/></a><span class="hero-availability">Agent Harness 工程师实习<br/><small>可长期实习 · 随时到岗</small></span></div><button class="terminal-launch" data-terminal data-reveal><span><Icon name="terminal"/><code>zaixi@home <b>~ $</b></code><span class="launch-text">输入 help，换一种方式探索</span></span><kbd>`</kbd></button></section>
  <section class="home-block" aria-labelledby="work-title"><div class="block-heading" data-reveal><div><span class="eyebrow">01 / 精选实践</span><h2 id="work-title">正在构建</h2></div><a class="subtle-link" href="/projects/">全部项目 <span>{projects.length}</span><Icon name="arrow"/></a></div><div class="work-grid">{projects.slice(0,2).map((p,index) => <ProjectCard project={p} compact index={index}/>)}</div></section>
  <section class="home-block" aria-labelledby="writing-title"><div class="block-heading" data-reveal><div><span class="eyebrow">02 / 工程思考</span><h2 id="writing-title">写下来，想清楚</h2></div><a class="subtle-link" href="/articles/">全部文章 <Icon name="arrow"/></a></div><div class="essay-list">{articles.map((article,index) => <ArticleRow article={article} index={index}/>)}</div></section>
  <section class="home-contact" data-reveal><span class="eyebrow">下一段旅程</span><div><h2>期待在真实团队里，<br/>继续把想法做成工具。</h2><button class="round-action" data-contact aria-label="联系 Zaixi"><Icon name="arrow"/></button></div><p>{site.cities.join(' / ')} · 接受异地线下实习</p></section>
</Base>
