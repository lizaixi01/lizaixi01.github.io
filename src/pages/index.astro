---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import Icon from '../components/Icon.astro';
import Gmail from '../components/Gmail.astro';
import { site, projects } from '../data/site';
const articles = (await getCollection('articles')).sort((a,b) => a.data.order-b.data.order);
---
<Base description="Zaixi Li，电子科技大学在读，寻找 Agent Harness 工程师实习。公开项目、工程思考与联系方式。">
  <section class="home-profile" aria-label="个人介绍">
    <img class="portrait" src="/assets/avatar.webp" width="176" height="176" alt="Zaixi 在雪山前的旅行照片" fetchpriority="high"/>
    <div class="profile-name"><span class="kicker">李在希 / Zaixi Li</span><h1>Zaixi</h1><div class="meta-links"><span>成都 · 电子科技大学</span><a href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github"/>GitHub ↗</a></div></div>
    <button class="pill" data-contact><span class="status-dot"/>联系我 <span aria-hidden="true">↗</span></button>
  </section>
  <Section title="关于我">
    <h2 class="tagline">All in on AI Agents.</h2><p>{site.introduction}</p>
    <div class="section-actions"><span class="availability"><span class="status-dot"/>寻找 Agent Harness 工程师实习</span><a class="text-link" href="/about/">更多介绍 <Icon name="arrow"/></a></div>
  </Section>
  <Section title="正在构建" id="work">
    <div class="home-projects">{projects.slice(0,2).map(p => <ProjectCard project={p} compact />)}</div>
    <div class="section-footer"><a class="text-link" href="/projects/">查看全部项目 <Icon name="arrow"/></a></div>
  </Section>
  <Section title="思考记录">
    <div>{articles.map(article => <ArticleRow article={article}/>)}</div>
    <div class="section-footer"><a class="text-link" href="/articles/">浏览文章目录 <Icon name="arrow"/></a></div>
  </Section>
  <Section title="保持联系">
    <div class="connect-panel"><div><strong>可长期实习，接受异地线下。</strong><p>{site.cities.join(' / ')} · 随时到岗</p><Gmail/></div><button class="pill" data-contact>聊一聊 <span aria-hidden="true">↗</span></button></div>
  </Section>
</Base>
