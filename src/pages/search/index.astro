---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import SiteSearch from '@/components/search/SiteSearch.astro'
---

<PageLayout meta={{ title: 'Search', description: '搜索 Zaixi 的文章与项目', noindex: true }}>
  <Button title='Back' href='/blog/' variant='back' />
  <main id='main' class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'><h1 class='mb-6 text-3xl font-medium'>Search</h1></div>
    <div id='content' class='animate'><p>搜索文章、项目与关键词。</p><SiteSearch /></div>
  </main>
</PageLayout>
