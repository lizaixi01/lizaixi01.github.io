---
import { site } from '@/data/site'

import PageLayout from '@/layouts/CommonPage.astro'
import ContactQR from '@/components/contact/ContactQR.astro'
import Gmail from '@/components/Gmail.astro'
import wechat from '@/assets/wechat.jpg'

const headings = [
  { depth: 2, slug: 'how-to-reach', text: 'How to Reach Me' },
  { depth: 2, slug: 'internship', text: 'Internship' }
]
---

<PageLayout title='Contact' {headings}>
  <p>欢迎聊聊 Agent、正在做的项目，或下一段实习机会。</p>
  <h2 id='how-to-reach'>How to Reach Me</h2>
  <div class='not-prose my-4 flex flex-wrap items-center gap-4'>
    <Gmail /><button
      class='rounded-full border px-3 py-1.5 text-sm hover:bg-muted'
      data-copy={site.email}>复制邮箱</button>
  </div>
  <p><a href={site.github} target='_blank' rel='noopener noreferrer'>GitHub · lizaixi01 ↗</a></p>
  <p>把鼠标移到卡片上，或轻点卡片，查看微信二维码。</p>
  <ContactQR
    class='my-6'
    items={[
      {
        name: '微信',
        hint: '悬停或轻点显示二维码',
        image: wechat,
        methodName: 'wechat',
        note: '微信扫一扫，添加好友'
      }
    ]}
  />
  <h2 id='internship'>Internship</h2>
  <p>寻找 Agent Harness 工程师实习。可长期实习、随时到岗，接受异地线下。</p>
  <p>{site.cities.join(' / ')}</p>
</PageLayout>
