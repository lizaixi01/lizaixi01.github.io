---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const info = `Name: ${site.title}\nDesc: ${site.description}\nLink: https://lizaixi01.github.io/\nAvatar: https://lizaixi01.github.io/assets/avatar.webp`;
---
<Base title="友链" description="同行的博客与 Zaixi 的友链信息。">
  <header class="page-intro"><span class="kicker">友链 / 同行的站点</span><h1>在各自的路上，交换想法。</h1><p>一些值得继续阅读的个人站点。</p></header>
  <a class="friend-card" href="https://www.joyehuang.me/" target="_blank" rel="noopener noreferrer"><span class="friend-monogram">J</span><div><strong>Joye Personal Blog</strong><p>AI Agent、全栈开发与个人思考。本次博客重构的参考。</p></div><Icon name="arrow"/></a>
  <div class="prose"><h2>我的网站信息</h2><p>欢迎交流博客与项目。交换友链可以通过邮箱或微信联系我。</p></div>
  <div class="copy-card"><pre>{info}</pre><button data-copy={info}>复制全部信息</button></div>
</Base>
