---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const info = `Name: ${site.title}\nDesc: ${site.description}\nLink: https://lizaixi01.github.io/\nAvatar: https://lizaixi01.github.io/assets/avatar.webp`;
---
<Base title="友链" description="同行的博客与 Zaixi 的友链信息。">
  <PageHeader number="05" label="友链" title="在各自的路上，交换想法。" description="一些值得继续阅读的个人站点。"/>
  <a class="friend-card" href="https://www.joyehuang.me/" target="_blank" rel="noopener noreferrer" data-reveal><span class="friend-monogram">J</span><div><strong>Joye Personal Blog</strong><p>AI Agent、全栈开发与个人思考。本站重构的参考。</p></div><Icon name="external"/></a>
  <div class="prose" data-reveal><h2>我的网站信息</h2><p>欢迎交流博客与项目。交换友链可以通过邮箱或微信联系我。</p></div>
  <div class="copy-card" data-reveal><pre>{info}</pre><button data-copy={info}>复制全部信息</button></div>
</Base>
