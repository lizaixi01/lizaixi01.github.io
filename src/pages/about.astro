---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import Gmail from '../components/Gmail.astro';
import Icon from '../components/Icon.astro';
---
<Base title="关于" active="about" description="李在希 Zaixi Li，电子科技大学电子信息科学与技术本科在读。关注 Agent Harness，寻找实习机会。">
  <PageHeader number="04" label="关于" title="你好，我是李在希。" description="All in on AI Agents. 从自己的问题开始，也期待走进真实的工程现场。"/>
  <section class="about-profile" aria-label="个人信息" data-reveal><div class="about-identity"><img src="/assets/avatar.webp" width="176" height="176" alt="Zaixi 的雪山旅行照片"/><div><strong>Zaixi Li</strong><span>李在希 · 全网昵称 Zaixi</span><span>{site.location}，中国</span></div></div><dl class="about-facts"><div><dt>大学</dt><dd>{site.university}</dd></div><div><dt>专业</dt><dd>{site.major}</dd></div><div><dt>预计毕业</dt><dd>{site.graduation}</dd></div><div><dt>关注方向</dt><dd>Agent Harness</dd></div></dl></section>
  <section class="about-story"><div class="prose" data-reveal><h2>学习，构建，再回到问题。</h2><p>{site.introduction}</p><p>Learn-Agent 来自我的编程学习需求。后来，我通过 PiLoop 探索主动执行与偏好记忆，通过 Legion 探索多个 Agent 的分工、独立验收与可恢复执行。对我而言，项目也是把抽象判断变成可以运行和检查的过程。</p></div><div class="path-list"><div class="path-item" data-reveal><span>01</span><div><h3>把额外工作交给工具。</h3><p>先帮助用户跨过眼前的卡点，再在后台整理知识。主动承担可以自动完成的工作，让用户专注于真正需要判断的选择。</p></div></div><div class="path-item" data-reveal><span>02</span><div><h3>把结论放回证据里。</h3><p>记录来源，允许修改，保留执行和验证的过程。在失败时说清楚发生了什么；速度有价值，可检查的交付同样重要。</p></div></div><div class="path-item" data-reveal><span>03</span><div><h3>在真实约束中继续学习。</h3><p>这些判断来自个人学习和项目实践。我希望在真实团队里理解业务约束、协作成本与运行中的失败，也会区分已经验证的事实和仍待检验的想法。</p></div></div></div><div class="interest-tags" data-reveal>{['Agent Harness','上下文与记忆','工具接口','独立验证','用户体验'].map(tag => <span>{tag}</span>)}</div></section>
  <section class="internship-card" data-reveal><span class="eyebrow"><span class="status-dot"/>寻找实习机会</span><h2>Agent Harness 工程师实习</h2><p>希望参与 Agent 执行流程、上下文管理与评估相关工作。可长期实习、随时到岗，接受异地线下。</p><div class="city-list">{site.cities.map(city => <span>{city}</span>)}</div><div class="project-actions"><button class="button primary" data-contact>聊聊机会 <Icon name="arrow"/></button><a class="button secondary" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github"/>GitHub <Icon name="external"/></a></div><div style="margin-top:18px"><Gmail/><button class="subtle-link" style="margin-left:14px" data-copy={site.email}>复制邮箱</button></div></section>
</Base>
